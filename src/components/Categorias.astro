---
// Categorías: cada una lleva a su grupo del catálogo (app.ts quita antes los filtros que la
// oculten). Con foto real si la categoría la tiene; si no, placa tipográfica en azul noche
// lista para recibir la foto cuando llegue (src/data/catalogo.ts → `portada`).
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import { CATEGORIAS, PRODUCTOS, COLCHON } from '../data/catalogo';
import { portadaDe } from '../lib/fotos';
import { precio } from '../lib/formato';

const datos = CATEGORIAS.map((c) => {
  const lista = PRODUCTOS.filter((p) => p.categoria === c.id);
  const foto = c.portada ? portadaDe(c.portada) : undefined;
  let meta = 'Atención por WhatsApp';
  if (c.id === 'colchones') meta = `${COLCHON.medida} · Envío gratis`;
  else if (lista.length) meta = `${lista.length} modelos · desde ${precio(Math.min(...lista.map((p) => p.precio)))}`;
  const accion = lista.length || c.id === 'colchones' ? 'Explorar' : 'Consultar';
  return { ...c, foto, meta, destino: c.id, accion, sinProductos: !lista.length && c.id !== 'colchones' };
});
---

<section id="categorias" class="seccion cats" aria-labelledby="cats-titulo">
  <div class="contenedor">
    <div class="cats__cab revela">
      <h2 id="cats-titulo" class="titular h2">Colecciones</h2>
      <a class="enlace-linea cats__todo" href="#catalogo">
        Ver catálogo completo
        <Icono nombre="flecha" />
      </a>
    </div>
    <ul class="cats__rejilla">
      {
        datos.map((c, i) => (
          <li class="revela" style={`--retraso:${(i % 3) * 90}ms`}>
            <a class:list={['cat', c.foto ? 'cat--foto' : 'cat--placa']} href={`#${c.destino}`} data-ir-grupo={c.destino}>
              {c.foto && <Foto foto={c.foto} alt="" sizes="(min-width: 1024px) 31vw, 48vw" class="cat__foto" />}
              {!c.foto && c.id === 'colchones' && <span class="cat__cifra titular cifra">{precio(COLCHON.precio)}</span>}
              {!c.foto && c.sinProductos && <span class="cat__cifra cat__pregunta">Pregunta por los modelos</span>}
              <span class="cat__texto">
                <span class="cat__nombre titular">{c.nombre}</span>
                <span class="cat__meta cifra">{c.meta}</span>
              </span>
              <span class="cat__ir">
                {c.accion}
                <Icono nombre="flecha" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cats {
    background: var(--marfil);
  }
  .cats__cab {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 8px 20px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .cats__todo {
    flex: none;
    margin-bottom: 6px;
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .cats__todo :global(svg) {
    width: 18px;
    height: 18px;
  }
  .cats__rejilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .cat {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 3 / 4;
    padding: 16px 14px;
    overflow: hidden;
    color: var(--marfil);
    background: var(--noche);
  }
  .cat :global(.cat__foto) {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--bg);
  }
  .cat :global(.cat__foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .cat--foto::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(16 26 39 / 0) 22%, rgb(16 26 39 / 0.55) 52%, rgb(16 26 39 / 0.93) 100%);
    transition: opacity 0.6s var(--ease);
  }
  .cat--placa::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid rgb(182 154 104 / 0.4);
    transition: inset 0.6s var(--ease);
  }
  .cat__cifra {
    position: absolute;
    top: 18%;
    left: 14px;
    right: 14px;
    color: var(--oro);
    font-size: clamp(1.75rem, 8vw, 3.5rem);
    line-height: 1;
  }
  .cat__pregunta {
    font: italic 500 clamp(1.5rem, 5.4vw, 2.5rem) / 1.05 var(--font-titular);
    max-width: 9em;
  }
  .cat__texto {
    display: grid;
    gap: 6px;
  }
  .cat__nombre {
    font-size: clamp(1.5rem, 5.6vw, 2.5rem);
    line-height: 1;
  }
  .cat__meta {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgb(245 241 233 / 0.86);
  }
  .cat__ir {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid rgb(245 241 233 / 0.25);
    color: var(--oro-claro);
    font: 500 0.6875rem/1 var(--font-texto);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .cat__ir :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.4s var(--ease);
  }
  @media (hover: hover) {
    .cat:hover :global(.cat__foto img) {
      transform: scale(1.05);
    }
    .cat:hover .cat__ir :global(svg) {
      transform: translateX(5px);
    }
    .cat--placa:hover::before {
      inset: 16px;
    }
  }
  @media (min-width: 768px) {
    .cats__rejilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .cat {
      aspect-ratio: 4 / 5;
      padding: 26px 24px;
    }
    .cat--placa::before {
      inset: 14px;
    }
    .cat__cifra {
      left: 24px;
    }
    .cat__meta {
      font-size: 0.9375rem;
    }
  }
  @media (min-width: 1100px) {
    .cat {
      aspect-ratio: 5 / 4;
    }
  }
</style>
