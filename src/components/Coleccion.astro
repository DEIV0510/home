---
// Una colección del catálogo, en dos partes para que el recorrido sea corto:
//   · Carrusel horizontal con los productos que tienen foto (deslizable con el dedo, con barra
//     de avance y flechas). Las tarjetas se ordenan/filtran igual que antes (app.ts).
//   · Carta de precios con los que aún no tienen foto: nombre ····· precio. En celular se ven
//     6 y el resto con «Ver los N modelos»; con un filtro o búsqueda se ve todo lo que coincide.
import Tarjeta from './Tarjeta.astro';
import Fila from './Fila.astro';
import Icono from './Icono.astro';
import type { Producto } from '../data/catalogo';
import { fotosDe } from '../lib/fotos';

interface Props {
  lista: Producto[];
  nombre: string;
  /** Primer número de orden (sigue la cuenta del catálogo completo). */
  inicio: number;
}
const { lista, nombre, inicio } = Astro.props;
const conFoto = lista.filter((p) => fotosDe(p.id).length);
const sinFoto = lista.filter((p) => !fotosDe(p.id).length);
const VISIBLES = 6;
---

<div class="coleccion" data-coleccion>
  {
    conFoto.length > 0 && (
      <div class="riel-caja revela" data-sub>
        <div class="riel" data-riel data-rejilla tabindex="0" role="region" aria-label={`${nombre}: modelos con foto`}>
          {conFoto.map((p, i) => (
            <Tarjeta p={p} orden={inicio + i} />
          ))}
        </div>
        <div class="riel__pie" data-riel-pie>
          <div class="riel__progreso" aria-hidden="true">
            <span data-riel-barra />
          </div>
          <div class="riel__flechas">
            <button type="button" class="riel__flecha" data-riel-ant aria-label={`${nombre}: anteriores`}>
              <Icono nombre="izquierda" />
            </button>
            <button type="button" class="riel__flecha" data-riel-sig aria-label={`${nombre}: siguientes`}>
              <Icono nombre="derecha" />
            </button>
          </div>
        </div>
      </div>
    )
  }
  {
    sinFoto.length > 0 && (
      <div class="carta revela" data-sub data-carta>
        <div class="carta__cab">
          <p class="carta__titulo">{conFoto.length ? 'Más modelos' : 'Modelos'}</p>
          <p class="carta__nota">
            <Icono nombre="camara" />
            Fotos por WhatsApp
          </p>
        </div>
        <ul class="carta__lista" data-rejilla>
          {sinFoto.map((p, i) => (
            <Fila p={p} orden={inicio + conFoto.length + i} />
          ))}
        </ul>
        {sinFoto.length > VISIBLES && (
          <button type="button" class="carta__mas" data-carta-mas aria-expanded="false">
            Ver los {sinFoto.length} modelos
            <Icono nombre="abajo" />
          </button>
        )}
      </div>
    )
  }
</div>

<style>
  /* minmax(0, 1fr): sin esto la columna crece hasta el ancho de todas las tarjetas juntas y el
     celular aleja el zoom de toda la página. */
  .coleccion {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 5vw, 56px);
  }

  /* ── Carrusel ── */
  .riel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80vw, 330px);
    gap: 14px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    margin-inline: calc(-1 * var(--gutter));
    padding: 0 var(--gutter) 4px;
    scrollbar-width: none;
    outline-offset: -2px;
  }
  .riel::-webkit-scrollbar {
    display: none;
  }
  .riel > :global(*) {
    scroll-snap-align: start;
  }
  .riel__pie {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 20px;
  }
  .riel__progreso {
    position: relative;
    flex: 1;
    height: 2px;
    overflow: hidden;
    background: var(--linea);
  }
  .riel__progreso span {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--ancho, 30%);
    background: var(--oro);
    transform: translate3d(var(--x, 0px), 0, 0);
    transition: width 0.3s var(--ease);
  }
  .riel__flechas {
    display: flex;
    gap: 6px;
  }
  .riel__flecha {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--linea);
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s,
      opacity 0.3s;
  }
  .riel__flecha :global(svg) {
    width: 18px;
    height: 18px;
  }
  .riel__flecha:disabled {
    opacity: 0.3;
    cursor: default;
  }
  @media (hover: hover) {
    .riel__flecha:not(:disabled):hover {
      background: var(--carbon);
      border-color: var(--carbon);
      color: var(--oro);
    }
  }
  /* (Estados que pone app.ts — sin desborde, carta abierta/filtrada — en global.css.) */
  @media (min-width: 768px) {
    .riel {
      grid-auto-columns: calc((100% - 2 * 18px) / 2.4);
      gap: 18px;
    }
  }
  @media (min-width: 1024px) {
    .riel {
      grid-auto-columns: calc((100% - 3 * 22px) / 3.3);
      gap: 22px;
    }
  }

  /* ── Carta de precios ── */
  .carta__cab {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--carbon);
  }
  .carta__titulo {
    font: italic 500 clamp(1.5rem, 4vw, 2rem) / 1.1 var(--font-titular);
  }
  .carta__nota {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--gris-tinta);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .carta__nota :global(svg) {
    width: 16px;
    height: 16px;
  }
  .carta__mas {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    margin-top: 8px;
    font: 600 0.75rem/1 var(--font-texto);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oro-tinta);
  }
  .carta__mas :global(svg) {
    width: 18px;
    height: 18px;
  }
  @media (min-width: 768px) {
    .carta__lista {
      columns: 2;
      column-gap: clamp(32px, 5vw, 72px);
    }
    .carta__lista > :global(li) {
      break-inside: avoid;
    }
    .carta__mas {
      display: none;
    }
  }
</style>
