---
// Tarjeta de producto: foto protagonista, nombre, precio grande y dos acciones.
//   · «Quiero este» → WhatsApp directo a la línea principal con el mensaje del brief.
//   · Ícono de WhatsApp → elegir línea (app.ts); sin JS va a la línea principal.
// Sin foto todavía: una placa con el nombre del modelo que pide las fotos por WhatsApp.
// Bases cama: el precio depende del ancho (100/120/140 cm); al elegirlo, app.ts cambia el
// precio y los mensajes.
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import type { Producto } from '../data/catalogo';
import { fotosDe } from '../lib/fotos';
import { precio, normalizar, nombreCorto } from '../lib/formato';
import { LINEA_PRINCIPAL } from '../lib/empresa';
import { wa, mensajeQuiero, mensajeConsulta } from '../lib/mensajes';

interface Props {
  p: Producto;
  orden: number;
}
const { p, orden } = Astro.props;
const fotos = fotosDe(p.id);
const foto = fotos[0];
const datos = { articulo: p.articulo, nombre: p.nombre, precio: precio(p.precio), desde: Boolean(p.medidas) };
const quiero = mensajeQuiero(datos);
const consulta = mensajeConsulta(datos, Boolean(foto));
const ETIQUETAS = { compacta: 'Compacta', 'en-l': 'En L' } as const;
const etiqueta = (p.etiquetas ?? []).map((e) => ETIQUETAS[e]).join(' · ');
const buscar = normalizar(`${p.nombre} ${etiqueta}`);
---

<article
  id={`p-${p.id}`}
  class="tarjeta revela"
  data-producto
  data-id={p.id}
  data-cat={p.categoria}
  data-etiquetas={(p.etiquetas ?? []).join(' ')}
  data-buscar={buscar}
  data-precio={p.precio}
  data-orden={orden}
  data-foto={foto ? '1' : '0'}
  data-nombre={p.nombre}
  data-articulo={p.articulo}
>
  <div class="tarjeta__media" data-media={p.categoria}>
    {
      foto ? (
        <button type="button" class="tarjeta__ver" data-visor={p.id} aria-label={`Ver ${fotos.length > 1 ? `las ${fotos.length} fotos` : 'la foto'}: ${p.nombre}`}>
          <Foto foto={foto} alt={p.nombre} sizes="(min-width: 1360px) 310px, (min-width: 1024px) 23vw, (min-width: 640px) 31vw, 47vw" />
          {fotos.length > 1 && (
            <span class="tarjeta__nfotos cifra">
              <Icono nombre="camara" />
              {fotos.length}
            </span>
          )}
        </button>
      ) : (
        <a class="placa" href={wa(LINEA_PRINCIPAL.internacional, consulta)} target="_blank" rel="noopener" data-lineas data-mensaje={consulta} data-consulta>
          <span class="placa__nombre">{nombreCorto(p.nombre)}</span>
          <span class="placa__pide">
            <Icono nombre="camara" />
            Pide fotos por WhatsApp
          </span>
        </a>
      )
    }
  </div>
  <div class="tarjeta__cuerpo">
    {etiqueta && <p class="tarjeta__etiqueta">{etiqueta}</p>}
    <h4 class="tarjeta__nombre">{p.nombre}</h4>
    <p class="tarjeta__precio">
      {p.medidas && <span class="tarjeta__desde" data-desde>Desde</span>}
      <span class="cifra" data-precio-texto>{precio(p.precio)}</span>
    </p>
    {
      p.medidas && (
        <fieldset class="medidas">
          <legend class="medidas__titulo">Ancho (cm)</legend>
          <div class="medidas__opciones">
            {p.medidas.map((m) => (
              <label class="medidas__op">
                <input type="radio" name={`ancho-${p.id}`} value={m.cm} data-precio={m.precio} />
                <span class="cifra">{m.cm}</span>
              </label>
            ))}
          </div>
        </fieldset>
      )
    }
    <div class="tarjeta__acciones">
      <a class="btn btn--oro tarjeta__quiero" href={wa(LINEA_PRINCIPAL.internacional, quiero)} target="_blank" rel="noopener" data-quiero>
        <span>Quiero este</span>
      </a>
      <a
        class="btn-icono tarjeta__consulta"
        href={wa(LINEA_PRINCIPAL.internacional, consulta)}
        target="_blank"
        rel="noopener"
        data-lineas
        data-mensaje={consulta}
        data-consulta
        aria-label={`Consultar por WhatsApp: ${p.nombre}`}
      >
        <Icono nombre="whatsapp" />
        <span class="tarjeta__consulta-texto">Consultar</span>
      </a>
    </div>
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .tarjeta__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--marfil-2);
  }
  /* Las bases cama vienen en fotos casi cuadradas o verticales. */
  .tarjeta__media[data-media='bases-cama'] {
    aspect-ratio: 1;
  }
  .tarjeta__ver {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .tarjeta__ver :global(picture) {
    display: block;
    height: 100%;
    background: var(--bg);
  }
  .tarjeta__ver :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--foco, 50% 50%);
    transition: transform 1.1s var(--ease);
  }
  .tarjeta__nfotos {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    background: rgb(21 21 21 / 0.72);
    color: var(--marfil);
    font-size: 0.75rem;
    line-height: 1;
  }
  .tarjeta__nfotos :global(svg) {
    width: 14px;
    height: 14px;
  }

  /* Placa: producto sin foto todavía. */
  .placa {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 14px;
    padding: 16px;
    text-align: center;
    background: var(--marfil-2);
    color: var(--noche);
  }
  .placa::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid rgb(122 97 54 / 0.4);
    transition: inset 0.6s var(--ease);
    pointer-events: none;
  }
  .placa__nombre {
    font: italic 500 clamp(1.625rem, 5.4vw, 2.375rem) / 1 var(--font-titular);
    letter-spacing: 0;
    text-wrap: balance;
  }
  .placa__pide {
    display: grid;
    justify-items: center;
    gap: 6px;
    color: var(--oro-tinta);
    font: 500 0.6875rem/1.3 var(--font-texto);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .placa__pide :global(svg) {
    width: 18px;
    height: 18px;
  }

  .tarjeta__cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 14px 12px 12px;
  }
  .tarjeta__etiqueta {
    margin-bottom: 6px;
    color: var(--oro-tinta);
    font: 500 0.6875rem/1.2 var(--font-texto);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .tarjeta__nombre {
    font: 600 1.25rem/1.08 var(--font-titular);
    letter-spacing: 0.005em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .tarjeta__precio {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 8px;
    margin-top: 8px;
    font: 600 1.1875rem/1.2 var(--font-texto);
    letter-spacing: 0.01em;
  }
  .tarjeta__desde {
    color: var(--gris-tinta);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .medidas {
    margin-top: 12px;
  }
  .medidas__titulo {
    padding: 0;
    margin-bottom: 6px;
    color: var(--gris-tinta);
    font: 500 0.6875rem/1 var(--font-texto);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .medidas__opciones {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .medidas__op {
    position: relative;
    cursor: pointer;
  }
  .medidas__op input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .medidas__op span {
    display: grid;
    place-items: center;
    min-height: 44px;
    border: 1px solid var(--linea);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .medidas__op input:checked + span {
    background: var(--carbon);
    border-color: var(--carbon);
    color: var(--marfil);
  }
  .medidas__op input:focus-visible + span {
    outline: 2px solid var(--oro);
    outline-offset: 2px;
  }

  .tarjeta__acciones {
    display: flex;
    gap: 8px;
    margin-top: auto;
    padding-top: 14px;
  }
  .tarjeta__quiero {
    flex: 1;
    min-width: 0;
    padding-inline: 10px;
    letter-spacing: 0.12em;
  }
  .tarjeta__consulta {
    color: var(--carbon);
    border-color: var(--linea);
  }
  .tarjeta__consulta-texto {
    display: none;
  }
  /* Tarjeta angosta (≤ 250 px: 2 columnas en celular, 3 en tablet chica, 4 en portátil chico):
     botones uno sobre otro y «Consultar» con su texto. Media queries (no container queries):
     más baratas en el primer diseño con 44 tarjetas. Cortes calculados con la rejilla de
     Catalogo.astro. */
  @media (max-width: 862.98px), (min-width: 1024px) and (max-width: 1179.98px) {
    .tarjeta__acciones {
      flex-direction: column;
      gap: 6px;
    }
    .tarjeta__quiero {
      flex: none;
      min-height: 46px;
      letter-spacing: 0.1em;
    }
    .tarjeta__consulta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      height: 40px;
      font: 500 0.8125rem/1 var(--font-texto);
      letter-spacing: 0.04em;
    }
    .tarjeta__consulta :global(svg) {
      width: 17px;
      height: 17px;
    }
    .tarjeta__consulta-texto {
      display: inline;
    }
  }

  @media (hover: hover) {
    .tarjeta:hover {
      transform: translate3d(0, -4px, 0);
      box-shadow: 0 18px 40px -24px rgb(21 21 21 / 0.45);
    }
    .tarjeta:hover .tarjeta__ver :global(img) {
      transform: scale(1.045);
    }
    .tarjeta:hover .placa::before {
      inset: 16px;
    }
    .tarjeta__consulta:hover {
      background: var(--carbon);
      border-color: var(--carbon);
      color: var(--oro);
    }
  }
  @media (min-width: 640px) {
    .tarjeta__cuerpo {
      padding: 18px 18px 18px;
    }
    .tarjeta__nombre {
      font-size: 1.5rem;
    }
    .tarjeta__precio {
      font-size: 1.3125rem;
    }
  }
  @media (max-width: 359.98px) {
    .tarjeta__quiero {
      letter-spacing: 0.06em;
      font-size: 0.75rem;
    }
  }
</style>
