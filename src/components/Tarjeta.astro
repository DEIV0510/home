---
// Tarjeta de producto CON foto (los que aún no tienen foto van en la carta de precios,
// Fila.astro). Sin caja: la foto manda; debajo, nombre, precio y una sola acción.
//   · «Quiero este» → WhatsApp directo a la línea principal con el mensaje del brief.
//   · Ícono de WhatsApp sobre la foto → elegir línea (app.ts); sin JS va a la línea principal.
//   · Tocar la foto abre el visor con todas las fotos completas.
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import type { Producto } from '../data/catalogo';
import { fotosDe } from '../lib/fotos';
import { precio, normalizar } from '../lib/formato';
import { LINEA_PRINCIPAL } from '../lib/empresa';
import { wa, mensajeQuiero, mensajeConsulta } from '../lib/mensajes';

interface Props {
  p: Producto;
  orden: number;
}
const { p, orden } = Astro.props;
const fotos = fotosDe(p.id);
const foto = fotos[0]!;
const datos = { articulo: p.articulo, nombre: p.nombre, precio: precio(p.precio) };
const quiero = mensajeQuiero(datos);
const consulta = mensajeConsulta(datos, true);
const ETIQUETAS = { compacta: 'Compacta', 'en-l': 'En L' } as const;
const etiqueta = (p.etiquetas ?? []).map((e) => ETIQUETAS[e]).join(' · ');
---

<article
  id={`p-${p.id}`}
  class="tarjeta"
  data-producto
  data-id={p.id}
  data-cat={p.categoria}
  data-etiquetas={(p.etiquetas ?? []).join(' ')}
  data-buscar={normalizar(`${p.nombre} ${etiqueta}`)}
  data-precio={p.precio}
  data-orden={orden}
  data-foto="1"
  data-nombre={p.nombre}
  data-articulo={p.articulo}
>
  <div class="tarjeta__media">
    <button type="button" class="tarjeta__ver" data-visor={p.id} aria-label={`Ver ${fotos.length > 1 ? `las ${fotos.length} fotos` : 'la foto'}: ${p.nombre}`}>
      <Foto foto={foto} alt={p.nombre} sizes="(min-width: 1024px) 380px, 80vw" />
    </button>
    {
      fotos.length > 1 && (
        <span class="tarjeta__nfotos cifra" aria-hidden="true">
          1/{fotos.length}
        </span>
      )
    }
    <a
      class="tarjeta__consulta"
      href={wa(LINEA_PRINCIPAL.internacional, consulta)}
      target="_blank"
      rel="noopener"
      data-lineas
      data-mensaje={consulta}
      data-consulta
      aria-label={`Consultar por WhatsApp: ${p.nombre}`}
    >
      <Icono nombre="whatsapp" />
    </a>
  </div>
  <div class="tarjeta__cuerpo">
    <h4 class="tarjeta__nombre">{p.nombre}</h4>
    {etiqueta && <p class="tarjeta__etiqueta">{etiqueta}</p>}
    <div class="tarjeta__pie">
      <p class="tarjeta__precio cifra" data-precio-texto>{precio(p.precio)}</p>
      <a class="tarjeta__quiero" href={wa(LINEA_PRINCIPAL.internacional, quiero)} target="_blank" rel="noopener" data-quiero>
        <span>Quiero este</span>
        <Icono nombre="flecha" />
      </a>
    </div>
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .tarjeta__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--marfil-2);
  }
  .tarjeta__ver {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .tarjeta__ver :global(picture) {
    display: block;
    height: 100%;
    background: var(--bg);
  }
  .tarjeta__ver :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--foco, 50% 50%);
    transition: transform 1.1s var(--ease);
  }
  .tarjeta__nfotos {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 4px 7px;
    background: rgb(21 21 21 / 0.7);
    color: var(--marfil);
    font-size: 0.75rem;
    line-height: 1;
    pointer-events: none;
  }
  .tarjeta__consulta {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: rgb(245 241 233 / 0.94);
    color: var(--carbon);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
    -webkit-tap-highlight-color: transparent;
  }
  .tarjeta__consulta :global(svg) {
    width: 20px;
    height: 20px;
  }

  /* El pie (precio + «Quiero este») va siempre abajo: con o sin etiqueta, las tarjetas del
     carrusel quedan alineadas. */
  .tarjeta__cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
  }
  .tarjeta__nombre {
    font: 600 1.375rem/1.08 var(--font-titular);
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }
  .tarjeta__etiqueta {
    color: var(--gris-tinta);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }
  .tarjeta__pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--linea);
  }
  /* Aire mínimo sobre la línea del pie aunque no sobre espacio. */
  .tarjeta__cuerpo > :nth-last-child(2) {
    margin-bottom: 8px;
  }
  .tarjeta__precio {
    font: 600 1.1875rem/1 var(--font-texto);
    letter-spacing: 0.01em;
  }
  .tarjeta__quiero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px;
    background: var(--carbon);
    color: var(--marfil);
    font: 600 0.75rem/1 var(--font-texto);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.35s var(--ease);
    -webkit-tap-highlight-color: transparent;
  }
  .tarjeta__quiero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--oro);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.5s var(--ease);
  }
  .tarjeta__quiero :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--oro);
    transition:
      transform 0.35s var(--ease),
      color 0.35s;
  }
  .tarjeta__quiero:active {
    transform: scale(0.98);
  }

  @media (hover: hover) {
    .tarjeta:hover .tarjeta__ver :global(img) {
      transform: scale(1.045);
    }
    .tarjeta__quiero:hover {
      color: var(--carbon);
    }
    .tarjeta__quiero:hover::before {
      transform: scaleX(1);
      transform-origin: 0 50%;
    }
    .tarjeta__quiero:hover :global(svg) {
      color: var(--carbon);
      transform: translateX(4px);
    }
    .tarjeta__consulta:hover {
      background: var(--carbon);
      color: var(--oro);
    }
  }
  @media (min-width: 1024px) {
    .tarjeta__nombre {
      font-size: 1.5rem;
    }
    .tarjeta__precio {
      font-size: 1.3125rem;
    }
  }
</style>
