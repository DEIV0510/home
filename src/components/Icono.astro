---
// Íconos de trazo fino (1.4) en un solo estilo. Decorativos: el texto del botón o su
// aria-label dice qué hace. WhatsApp va relleno (es su marca reconocible).
interface Props {
  nombre:
    | 'whatsapp'
    | 'instagram'
    | 'flecha'
    | 'telefono'
    | 'buscar'
    | 'cerrar'
    | 'menu'
    | 'fabrica'
    | 'disenos'
    | 'comodidad'
    | 'atencion'
    | 'garantia'
    | 'envio'
    | 'izquierda'
    | 'derecha'
    | 'camara'
    | 'abajo';
  class?: string;
}
const { nombre, class: clase } = Astro.props;
const relleno = nombre === 'whatsapp';
---

<svg
  class={clase}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  focusable="false"
  fill={relleno ? 'currentColor' : 'none'}
  stroke={relleno ? 'none' : 'currentColor'}
  stroke-width="1.4"
  stroke-linecap="square"
  stroke-linejoin="miter"
>
  {
    nombre === 'whatsapp' && (
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    )
  }
  {
    nombre === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
      </>
    )
  }
  {nombre === 'flecha' && <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />}
  {nombre === 'telefono' && <path d="M5.2 3.8h3.3l1.8 4.6-2.4 1.5a11.2 11.2 0 0 0 6 6l1.5-2.4 4.6 1.8v3.3a1.6 1.6 0 0 1-1.7 1.6C10.5 19.7 4.3 13.5 3.6 5.5a1.6 1.6 0 0 1 1.6-1.7Z" />}
  {
    nombre === 'buscar' && (
      <>
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="m15.5 15.5 5 5" />
      </>
    )
  }
  {nombre === 'cerrar' && <path d="m6 6 12 12M18 6 6 18" />}
  {nombre === 'menu' && <path d="M3 8.5h18M3 15.5h18" />}
  {nombre === 'fabrica' && <path d="M4 3.5v17h17M4 7.5h3M4 11.5h2M4 15.5h3M8 20.5v-3M12 20.5v-2M16 20.5v-3M9.5 14.5 18 6l1.5 1.5L11 16H9.5Z" />}
  {
    nombre === 'disenos' && (
      <>
        <rect x="3.5" y="3.5" width="7" height="7" />
        <rect x="13.5" y="3.5" width="7" height="7" />
        <rect x="3.5" y="13.5" width="7" height="7" />
        <path d="M13.5 13.5h7v7h-7z" fill="currentColor" stroke="none" opacity=".35" />
        <rect x="13.5" y="13.5" width="7" height="7" />
      </>
    )
  }
  {nombre === 'comodidad' && <path d="M5 11V7.5h14V11M2.5 12.5h3V15h13v-2.5h3v6h-19ZM5 18.5v2M19 18.5v2M12 7.5V15" />}
  {nombre === 'atencion' && <path d="M3.5 4.5h17v11.5H9.5L5 20v-4H3.5ZM8 10.3h.01M12 10.3h.01M16 10.3h.01" />}
  {nombre === 'garantia' && <path d="M12 3 19 5.8v5.7c0 4.3-2.9 7.6-7 9.5-4.1-1.9-7-5.2-7-9.5V5.8ZM8.8 12l2.2 2.2 4.3-4.4" />}
  {
    nombre === 'envio' && (
      <>
        <path d="M2.5 6.5h11v10h-11ZM13.5 9.5h4l3 3.2v3.8h-7" />
        <circle cx="6.5" cy="17.5" r="1.8" />
        <circle cx="17" cy="17.5" r="1.8" />
      </>
    )
  }
  {nombre === 'izquierda' && <path d="M15 4.5 7.5 12l7.5 7.5" />}
  {nombre === 'derecha' && <path d="M9 4.5 16.5 12 9 19.5" />}
  {
    nombre === 'camara' && (
      <>
        <path d="M3.5 7.5h4l1.8-2.5h5.4l1.8 2.5h4v12h-17Z" />
        <circle cx="12" cy="13" r="3.4" />
      </>
    )
  }
  {nombre === 'abajo' && <path d="m6 9.5 6 6 6-6" />}
</svg>
