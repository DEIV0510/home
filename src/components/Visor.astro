---
// Visor de fotos: la foto COMPLETA (sin recorte, object-fit: contain), deslizable con el
// dedo (scroll-snap nativo) y con flechas. Lo llena app.ts con los datos de #datos-fotos;
// las imágenes se crean con la API del DOM (nada de innerHTML: la CSP lo prohíbe).
import Icono from './Icono.astro';
---

<dialog id="visor" class="visor" aria-labelledby="visor-nombre">
  <div class="visor__cab">
    <div>
      <h2 id="visor-nombre" class="visor__nombre" data-visor-nombre></h2>
      <p class="visor__precio cifra" data-visor-precio></p>
    </div>
    <button class="visor__cerrar" type="button" data-cerrar aria-label="Cerrar fotos">
      <Icono nombre="cerrar" />
    </button>
  </div>
  <div class="visor__pista" data-visor-pista tabindex="0" aria-roledescription="carrusel" aria-label="Fotos del producto"></div>
  <div class="visor__pie">
    <div class="visor__nav">
      <button type="button" class="btn-icono" data-visor-ant aria-label="Foto anterior"><Icono nombre="izquierda" /></button>
      <span class="visor__cuenta cifra" data-visor-cuenta aria-live="polite"></span>
      <button type="button" class="btn-icono" data-visor-sig aria-label="Foto siguiente"><Icono nombre="derecha" /></button>
    </div>
    <a class="btn btn--oro visor__cta" href="#" target="_blank" rel="noopener" data-visor-cta>
      <Icono nombre="whatsapp" />
      <span>Quiero este</span>
    </a>
  </div>
</dialog>

<style>
  .visor {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(14 18 24 / 0.985);
    color: var(--marfil);
    flex-direction: column;
    opacity: 0;
    transition:
      opacity 0.35s var(--ease),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }
  .visor[open] {
    display: flex;
    opacity: 1;
  }
  @starting-style {
    .visor[open] {
      opacity: 0;
    }
  }
  .visor::backdrop {
    background: transparent;
  }
  .visor__cab,
  .visor__pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px var(--gutter);
    flex: none;
  }
  .visor__cab {
    padding-top: max(14px, env(safe-area-inset-top));
    border-bottom: 1px solid var(--linea-o);
  }
  .visor__nombre {
    font: 600 clamp(1.375rem, 4vw, 2rem) / 1.05 var(--font-titular);
    text-transform: uppercase;
  }
  .visor__precio {
    margin-top: 4px;
    color: var(--oro);
    font-weight: 500;
    font-size: 1.0625rem;
  }
  .visor__cerrar {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    margin-right: -12px;
  }
  .visor__cerrar :global(svg) {
    width: 24px;
    height: 24px;
  }
  .visor__pista {
    flex: 1;
    min-height: 0;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .visor__pista::-webkit-scrollbar {
    display: none;
  }
  .visor__pista :global(figure) {
    flex: 0 0 100%;
    display: grid;
    place-items: center;
    padding: 12px var(--gutter);
    scroll-snap-align: center;
  }
  .visor__pista :global(picture),
  .visor__pista :global(img) {
    width: 100%;
    height: 100%;
    max-height: 100%;
  }
  .visor__pista :global(img) {
    object-fit: contain;
  }
  .visor__pie {
    padding-bottom: max(14px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--linea-o);
  }
  .visor__nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .visor__nav .btn-icono {
    border-color: var(--linea-o);
  }
  .visor__nav .btn-icono:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .visor__cuenta {
    min-width: 3.5em;
    text-align: center;
    font-size: 0.875rem;
    color: var(--gris);
  }
</style>
