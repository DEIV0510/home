---
// Botón flotante de WhatsApp: aparece al dejar la portada (que ya tiene sus botones) y abre
// la elección de línea. Sin JS es un enlace directo a la línea principal.
import Icono from './Icono.astro';
import { LINEA_PRINCIPAL } from '../lib/empresa';
import { wa, MENSAJES } from '../lib/mensajes';
---

<a class="flotante" href={wa(LINEA_PRINCIPAL.internacional, MENSAJES.general)} target="_blank" rel="noopener" data-lineas data-mensaje={MENSAJES.general} data-flotante aria-label="Escribir por WhatsApp">
  <Icono nombre="whatsapp" />
  <span class="flotante__texto">WhatsApp</span>
</a>

<style>
  .flotante {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding-inline: 16px;
    background: var(--carbon);
    color: var(--marfil);
    border: 1px solid var(--oro);
    box-shadow: 0 12px 30px -12px rgb(0 0 0 / 0.5);
    font: 600 0.75rem/1 var(--font-texto);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      transform 0.5s var(--ease),
      opacity 0.4s var(--ease),
      background-color 0.3s;
    -webkit-tap-highlight-color: transparent;
  }
  .flotante :global(svg) {
    width: 24px;
    height: 24px;
    color: var(--oro);
  }
  .flotante__texto {
    display: none;
  }
  :global(html.js) .flotante:not(.is-visible) {
    transform: translate3d(0, 140%, 0);
    opacity: 0;
    pointer-events: none;
  }
  .flotante:active {
    transform: scale(0.96);
  }
  @media (hover: hover) {
    .flotante:hover {
      background: var(--noche);
    }
  }
  @media (min-width: 768px) {
    .flotante__texto {
      display: inline;
    }
    .flotante {
      padding-inline: 18px 20px;
    }
  }
</style>
