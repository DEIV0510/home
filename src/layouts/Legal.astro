---
import Base from './Base.astro';

interface Props {
  titulo: string;
  descripcion: string;
  actualizado: string;
}
const { titulo, descripcion, actualizado } = Astro.props;
---

<Base titulo={`${titulo} | HOME PREMIUM`} descripcion={descripcion} base="/">
  <article class="legal">
    <div class="legal__cab">
      <h1 class="titular legal__titulo">{titulo}</h1>
      <p class="legal__fecha">Última actualización: {actualizado}</p>
    </div>
    <div class="legal__texto">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding: calc(var(--cab-h) + clamp(48px, 8vw, 96px)) var(--gutter) clamp(72px, 10vw, 120px);
    background: var(--marfil);
  }
  .legal__cab,
  .legal__texto {
    max-width: 760px;
    margin-inline: auto;
  }
  .legal__titulo {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
  }
  .legal__fecha {
    margin-top: 14px;
    color: var(--gris-tinta);
    font-size: 0.9375rem;
  }
  .legal__texto {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--linea);
  }
  .legal__texto :global(h2) {
    margin: 36px 0 12px;
    font: 600 1.625rem/1.15 var(--font-titular);
    text-transform: uppercase;
  }
  .legal__texto :global(p),
  .legal__texto :global(li) {
    color: #2c2a27;
    line-height: 1.7;
  }
  .legal__texto :global(p + p) {
    margin-top: 12px;
  }
  .legal__texto :global(ul) {
    display: grid;
    gap: 8px;
    margin-top: 12px;
    padding-left: 1.2em;
    list-style: square;
  }
  .legal__texto :global(a) {
    color: var(--oro-tinta);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
