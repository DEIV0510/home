---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
---

<Base titulo="Página no encontrada | HOME PREMIUM" descripcion="La página que buscas no existe. Mira el catálogo de HOME PREMIUM." noindex base="/">
  <section class="nf">
    <p class="rotulo nf__rotulo">Error 404</p>
    <h1 class="titular nf__titulo">Esta página <em>no existe</em></h1>
    <p class="nf__texto">Puede que el enlace haya cambiado. Nuestro catálogo sigue aquí.</p>
    <a class="btn btn--oro" href="/#catalogo">
      <span>Ver catálogo</span>
      <Icono nombre="flecha" class="flecha" />
    </a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: 18px;
    min-height: 80svh;
    align-content: center;
    padding: calc(var(--cab-h) + 48px) var(--gutter) 80px;
    max-width: calc(var(--max) + 2 * var(--gutter));
    margin-inline: auto;
  }
  .nf__rotulo {
    color: var(--oro-tinta);
  }
  .nf__titulo {
    font-size: clamp(3rem, 9vw, 6rem);
  }
  .nf__titulo em {
    color: var(--oro-tinta);
  }
  .nf__texto {
    color: var(--gris-tinta);
  }
</style>
